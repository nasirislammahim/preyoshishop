rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin role check from admins collection or matching configured owner email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'nasirislammahimbd@gmail.com')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().keys().hasAll(['userId', 'name', 'phone', 'role']) &&
        incoming().userId == request.auth.uid &&
        incoming().role == 'customer';
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'savedAddresses']) && incoming().role == existing().role)
      );
      allow delete: if isAdmin();
    }

    // Products Collection (Public Read, Admin Write)
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isAdmin() &&
        incoming().keys().hasAll(['id', 'nameEn', 'nameBn', 'categoryId', 'regularPrice', 'stock', 'status']);
      allow update: if isValidId(productId) && isAdmin();
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Categories Collection (Public Read, Admin Write)
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidId(categoryId) && isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Admin can read all orders. Customer can read their own order.
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        resource.data.id == orderId // Guest lookup with direct ID reference
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // Anyone can create an order with valid data
      allow create: if isValidId(orderId) &&
        incoming().keys().hasAll(['id', 'customerName', 'phone', 'district', 'deliveryAddress', 'paymentMethod', 'deliveryType', 'subtotal', 'grandTotal', 'status']) &&
        incoming().status == 'pending' &&
        incoming().customerName is string && incoming().customerName.size() >= 2 && incoming().customerName.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() >= 8 && incoming().phone.size() <= 20 &&
        incoming().subtotal is number && incoming().subtotal >= 0 &&
        incoming().grandTotal is number && incoming().grandTotal >= 0;

      // Only admin can update order status, courier info, tracking ID
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) &&
        incoming().keys().hasAll(['id', 'productId', 'customerName', 'rating', 'comment']) &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().comment is string && incoming().comment.size() >= 2 && incoming().comment.size() <= 1000;
      allow update, delete: if isValidId(reviewId) && isAdmin();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isValidId(couponId) && isAdmin();
    }

    // Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isValidId(bannerId) && isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }
  }
}
